<Window x:Class="kEyLite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="kEyLite"
        Width="1040" Height="680"
        MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        SnapsToDevicePixels="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 侧边导航 -->
        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Top" Margin="20,22,20,18">
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/kEyLite;component/Assets/AppLogo.png"
                           Width="30" Height="30"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           VerticalAlignment="Center" />
                    <TextBlock Text="kEyLite"
                               FontSize="22" FontWeight="SemiBold"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="v0.1-beta"
                           Margin="4,8,0,0" Opacity="0.6" FontSize="12" />
            </StackPanel>

            <ListBox x:Name="NavList"
                     SelectionChanged="NavList_SelectionChanged"
                     Margin="10,0,10,0"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden">
                <ListBoxItem Padding="10,11">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ViewDashboard" Width="22" Height="22" VerticalAlignment="Center" />
                        <TextBlock Text="概览" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="14.5" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Padding="10,11">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="PlusCircle" Width="22" Height="22" VerticalAlignment="Center" />
                        <TextBlock Text="添加密钥" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="14.5" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Padding="10,11">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Cog" Width="22" Height="22" VerticalAlignment="Center" />
                        <TextBlock Text="设置" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="14.5" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Padding="10,11">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Information" Width="22" Height="22" VerticalAlignment="Center" />
                        <TextBlock Text="关于" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="14.5" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
        </DockPanel>

        <!-- 页面内容 + Snackbar -->
        <Grid Grid.Column="1">
            <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1,0,0,0" />
            <ContentControl x:Name="PageHost" Focusable="False" />
            <materialDesign:Snackbar x:Name="MainSnackbar"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Bottom"
                                     Margin="0,0,0,26" />
        </Grid>
    </Grid>
</Window>
