<UserControl x:Class="kEyLite.Views.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left" Margin="28,30,28,30">
            <StackPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/kEyLite;component/Assets/AppLogo.png"
                       Width="54" Height="54"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       VerticalAlignment="Center" />
                <StackPanel Margin="18,2,0,0" VerticalAlignment="Center">
                    <TextBlock Text="kEyLite" FontSize="34" FontWeight="SemiBold" />
                    <TextBlock Text="v0.1-beta - Codename Hyacine" Opacity="0.65" FontSize="14" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Copyright (C) 2026 Startorch Academy Team - Clara Herta"
                                   Opacity="0.6" FontSize="12.5"
                                   VerticalAlignment="Center" />
                        <TextBlock Margin="28,0,0,0" VerticalAlignment="Center" FontSize="12.5">
                            <Hyperlink Click="OpenLicense_Click"
                                       NavigateUri="https://github.com/Solaris-Startorch-Academy">
                                GitHub
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <TextBlock Margin="0,20,0,0" TextWrapping="Wrap" Opacity="0.85"
                       Text="你的下一个桌面验证器，何必是个插件 -- kEyLite 是一款轻量、开源的2FA（TOTP）桌面工具。" />

            <!-- 开源许可 -->
            <Expander Margin="0,18,0,0">
                <Expander.Header>
                    <TextBlock Text="开源许可" FontSize="16" FontWeight="SemiBold" />
                </Expander.Header>
                <StackPanel Margin="2,10,0,8">
                    <TextBlock TextWrapping="Wrap" Opacity="0.85"
                               Text="本软件采用 GNU 通用公共许可证第三版（GPLv3）发布。本软件是自由软件，你可以依据许可证条款对其再分发和/或修改；本软件按“现状”提供，不附带任何担保，详情请参见许可证全文。" />
                    <TextBlock Margin="0,10,0,0">
                        <Hyperlink Click="OpenLicense_Click"
                                   NavigateUri="https://www.gnu.org/licenses/gpl-3.0.html">
                            在浏览器中查看 GPLv3 全文
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Expander>

            <!-- 数据与隐私 -->
            <Expander Margin="0,8,0,0">
                <Expander.Header>
                    <TextBlock Text="数据与隐私" FontSize="16" FontWeight="SemiBold" />
                </Expander.Header>
                <StackPanel Margin="2,10,0,8">
                    <TextBlock TextWrapping="Wrap" Opacity="0.85"
                               Text="密钥数据保存在以下位置（整体加密存储，请勿随意分享该文件）：" />
                    <TextBlock x:Name="DataPathText" Margin="0,8,0,0" Opacity="0.7"
                               TextWrapping="Wrap" FontSize="12.5" />
                </StackPanel>
            </Expander>

            <!-- 技术栈 -->
            <Expander Margin="0,8,0,0">
                <Expander.Header>
                    <TextBlock Text="技术栈" FontSize="16" FontWeight="SemiBold" />
                </Expander.Header>
                <StackPanel Margin="2,10,0,8">
                    <TextBlock Opacity="0.85"
                               Text="WPF (C#) · Material Design in XAML · ZXing.Net · AES-256-GCM / DPAPI · RFC 6238" />
                    <TextBlock Margin="0,10,0,0" Opacity="0.6" FontSize="12.5"
                               Text="感谢所有开源项目与贡献者的付出。" />
                </StackPanel>
            </Expander>

            <!-- 第三方版权声明 -->
            <Expander Margin="0,8,0,0">
                <Expander.Header>
                    <TextBlock Text="第三方版权声明" FontSize="16" FontWeight="SemiBold" />
                </Expander.Header>
                <StackPanel Margin="2,10,0,8">
                    <TextBlock TextWrapping="Wrap" Opacity="0.85">
                        <Run Text="本应用使用了来自华为的 HarmonyOS Sans SC 字体，" />
                        <Hyperlink Click="OpenFontLicense_Click">在此查看许可证</Hyperlink>
                        <Run Text="。" />
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" Opacity="0.85" Margin="0,8,0,0"
                               Text="本应用的所有表情包均来自米游社，版权归 miHoYo 所有。" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>


