<Window x:Class="kEyLite.Views.Dialogs.FirstRunDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="欢迎使用 kEyLite"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}">

    <StackPanel Margin="30,28">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Image Source="pack://application:,,,/kEyLite;component/Assets/AppLogo.png"
                   Width="32" Height="32"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   VerticalAlignment="Center" />
            <TextBlock Text="kEyLite" FontSize="24" FontWeight="SemiBold"
                       Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="v0.1-beta - Codename Hyacine"
                   HorizontalAlignment="Center" Opacity="0.6" Margin="0,6,0,0" FontSize="12.5" />

        <TextBlock Margin="0,18,0,0" TextWrapping="Wrap" TextAlignment="Center" Opacity="0.85"
                   Text="首次使用前，强烈建议设置一个访问密码。设置后，你的密钥数据将使用该密码加密，每次启动 kEyLite 都需要输入密码解锁。" />

        <PasswordBox x:Name="NewBox"
                     Margin="0,20,0,0"
                     Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                     materialDesign:HintAssist.Hint="新密码（至少 4 位）" />
        <PasswordBox x:Name="ConfirmBox"
                     Margin="0,12,0,0"
                     Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                     materialDesign:HintAssist.Hint="确认新密码" />
        <TextBlock x:Name="ErrorText"
                   Visibility="Collapsed"
                   Margin="0,10,0,0"
                   Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
                   TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
            <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                    Content="跳过，稍后设置"
                    Margin="0,0,12,0"
                    Click="Skip_Click" />
            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                    Content="设置密码"
                    Click="Set_Click" />
        </StackPanel>

        <TextBlock Margin="0,18,0,0" FontSize="11.5" Opacity="0.55" TextWrapping="Wrap" TextAlignment="Center"
                   Text="不必担心，跳过密码后，数据依然基本安全，仅本机当前用户可读取。可随时在「设置」中启用访问密码。" />
    </StackPanel>
</Window>
