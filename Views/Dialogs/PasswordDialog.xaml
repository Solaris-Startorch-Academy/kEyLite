<Window x:Class="kEyLite.Views.Dialogs.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="密码管理"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}">

    <StackPanel Margin="28,26">
        <StackPanel Orientation="Horizontal">
            <materialDesign:PackIcon Kind="ShieldLock"
                                     Width="26" Height="26"
                                     Foreground="{DynamicResource PrimaryHueMidBrush}"
                                     VerticalAlignment="Center" />
            <TextBlock x:Name="HeaderText" FontSize="19" FontWeight="SemiBold"
                       Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock x:Name="SubText"
                   Margin="0,10,0,16" Opacity="0.75" TextWrapping="Wrap" />

        <PasswordBox x:Name="OldBox"
                     Visibility="Collapsed"
                     Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                     materialDesign:HintAssist.Hint="当前密码" />
        <PasswordBox x:Name="NewBox"
                     Margin="0,0,0,12"
                     Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                     materialDesign:HintAssist.Hint="新密码（至少 4 位）" />
        <PasswordBox x:Name="ConfirmBox"
                     Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                     materialDesign:HintAssist.Hint="确认新密码" />
        <TextBlock x:Name="ErrorText"
                   Visibility="Collapsed"
                   Margin="0,10,0,0"
                   Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
                   TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                    Content="取消"
                    IsCancel="True"
                    Margin="0,0,10,0" />
            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                    Content="确定"
                    IsDefault="True"
                    Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
