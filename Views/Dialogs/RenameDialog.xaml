<Window x:Class="kEyLite.Views.Dialogs.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="重命名密钥"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}">

    <StackPanel Margin="28,26">
        <StackPanel Orientation="Horizontal">
            <materialDesign:PackIcon Kind="Pencil"
                                     Width="26" Height="26"
                                     Foreground="{DynamicResource PrimaryHueMidBrush}"
                                     VerticalAlignment="Center" />
            <TextBlock Text="重命名密钥" FontSize="19" FontWeight="SemiBold"
                       Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Margin="0,10,0,16" Opacity="0.75" TextWrapping="Wrap"
                   Text="设置一个显示名称，方便你快速识别这条密钥。留空则显示签发者名称。" />

        <TextBox x:Name="NameBox"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 materialDesign:HintAssist.Hint="显示名称（可选）" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                    Content="取消"
                    IsCancel="True"
                    Margin="0,0,10,0" />
            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                    Content="保存"
                    IsDefault="True"
                    Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
