<Window x:Class="kEyLite.Views.FloatingKeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="kEyLite - 浮窗"
        Width="360"
        Height="420"
        MinWidth="360"
        MinHeight="420"
        MaxWidth="360"
        MaxHeight="420"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        Closing="Window_Closing">
    <Border Padding="16"
            BorderBrush="{DynamicResource MaterialDesignDivider}"
            BorderThickness="1"
            Background="{DynamicResource MaterialDesignPaper}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="快速概览"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock Text="使用 Ctrl+Shift+K 操作！"
                               Margin="0,3,0,0"
                               Opacity="0.6"
                               FontSize="12" />
                </StackPanel>
                <Button HorizontalAlignment="Right"
                        Style="{StaticResource MaterialDesignIconButton}"
                        ToolTip="关闭浮窗"
                        Click="Close_Click">
                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18" />
                </Button>
            </Grid>
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="KeysList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <materialDesign:Card Margin="0,0,0,10" Padding="12"
                                                 UniformCornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}"
                                                   Margin="0,3,0,0"
                                                   FontSize="11"
                                                   Opacity="0.6"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Code}"
                                                   Margin="0,8,0,0"
                                                   FontSize="24"
                                                   FontWeight="Bold"
                                                   FontFamily="Consolas" />
                                        <TextBlock Text="{Binding RemainingText}"
                                                   FontSize="11"
                                                   Opacity="0.6" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Width="38"
                                            Height="38"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource MaterialDesignIconButton}"
                                            ToolTip="复制验证码"
                                            Click="Copy_Click"
                                            Tag="{Binding}">
                                        <materialDesign:PackIcon Kind="ContentCopy" Width="18" Height="18" />
                                    </Button>
                                </Grid>
                            </materialDesign:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
