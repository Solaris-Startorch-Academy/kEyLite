<UserControl x:Class="kEyLite.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="28,20,28,24">
            <TextBlock Text="设置" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="外观、密码、备份与高级选项" Opacity="0.6" Margin="0,4,0,16" />

            <!-- 外观 -->
            <materialDesign:Card Margin="0,0,0,14" Padding="20,18" UniformCornerRadius="12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="PaletteOutline" Width="20" Height="20"
                                                 Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                 VerticalAlignment="Center" />
                        <TextBlock Text="外观" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <RadioButton x:Name="ThemeLight" GroupName="Theme" Content="浅色"
                                     Checked="ThemeLight_Checked" Margin="0,0,12,0" />
                        <RadioButton x:Name="ThemeDark" GroupName="Theme" Content="深色"
                                     Checked="ThemeDark_Checked" Margin="0,0,12,0" />
                        <RadioButton x:Name="ThemeSystem" GroupName="Theme" Content="跟随系统"
                                     Checked="ThemeSystem_Checked" />
                    </StackPanel>

                    <!-- 主色 / 备选色调色盘 -->
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <TextBlock Text="主题色" VerticalAlignment="Center" />
                        <materialDesign:PopupBox x:Name="PrimaryColorPopup" StaysOpen="False"
                                                 Margin="10,0,0,0" ToolTip="选择主题色（默认天蓝色）">
                            <materialDesign:PopupBox.ToggleContent>
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="PrimaryColorSwatch" Width="20" Height="20"
                                            CornerRadius="10" BorderThickness="1"
                                            BorderBrush="{DynamicResource MaterialDesignDivider}" />
                                    <TextBlock x:Name="PrimaryColorName" Margin="8,0,4,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </materialDesign:PopupBox.ToggleContent>
                            <materialDesign:PopupBox.PopupContent>
                                <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto">
                                    <WrapPanel x:Name="PrimaryPaletteHost" Width="248" Margin="8" />
                                </ScrollViewer>
                            </materialDesign:PopupBox.PopupContent>
                        </materialDesign:PopupBox>

                        <TextBlock Text="备选色" VerticalAlignment="Center" Margin="26,0,0,0" />
                        <materialDesign:PopupBox x:Name="SecondaryColorPopup" StaysOpen="False"
                                                 Margin="10,0,0,0" ToolTip="选择备选色（默认天蓝色）">
                            <materialDesign:PopupBox.ToggleContent>
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="SecondaryColorSwatch" Width="20" Height="20"
                                            CornerRadius="10" BorderThickness="1"
                                            BorderBrush="{DynamicResource MaterialDesignDivider}" />
                                    <TextBlock x:Name="SecondaryColorName" Margin="8,0,4,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </materialDesign:PopupBox.ToggleContent>
                            <materialDesign:PopupBox.PopupContent>
                                <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto">
                                    <WrapPanel x:Name="SecondaryPaletteHost" Width="248" Margin="8" />
                                </ScrollViewer>
                            </materialDesign:PopupBox.PopupContent>
                        </materialDesign:PopupBox>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

            <!-- 后台与启动 -->
            <materialDesign:Card Margin="0,0,0,14" Padding="20,18" UniformCornerRadius="12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="WindowRestore" Width="20" Height="20"
                                                 Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                 VerticalAlignment="Center" />
                        <TextBlock Text="应用行为" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <ToggleButton x:Name="BackgroundKeepToggle"
                                      Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                      Checked="BackgroundKeep_Checked" Unchecked="BackgroundKeep_Unchecked" />
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock Text="保留至后台" />
                            <TextBlock Text="关闭窗口后驻留系统托盘运行，可从托盘菜单打开主页面、设置、重启或退出。"
                                       Opacity="0.6" FontSize="12" TextWrapping="Wrap" MaxWidth="560"
                                       HorizontalAlignment="Left" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <ToggleButton x:Name="AutoStartToggle"
                                      Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                      Checked="AutoStart_Checked" Unchecked="AutoStart_Unchecked" />
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock Text="开机自动启动" />
                            <TextBlock Text="需要保留至后台以启用。开机后自动驻留托盘。"
                                       Opacity="0.6" FontSize="12" TextWrapping="Wrap" MaxWidth="560"
                                       HorizontalAlignment="Left" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

            <!-- 访问密码 -->
            <materialDesign:Card Margin="0,0,0,14" Padding="20,18" UniformCornerRadius="12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ShieldLock" Width="20" Height="20"
                                                 Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                 VerticalAlignment="Center" />
                        <TextBlock Text="访问密码" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="PasswordStatus"
                               Opacity="0.75" TextWrapping="Wrap" Margin="0,12,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="BtnSetPassword"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Content="设置密码" Click="SetPassword_Click" Margin="0,0,10,0" />
                        <Button x:Name="BtnChangePassword"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Content="修改密码" Click="ChangePassword_Click" Margin="0,0,10,0" />
                        <Button x:Name="BtnRemovePassword"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Content="移除密码" Click="RemovePassword_Click" />
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

            <!-- 备份 -->
            <materialDesign:Card Margin="0,0,0,14" Padding="20,18" UniformCornerRadius="12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FileExport" Width="20" Height="20"
                                                 Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                 VerticalAlignment="Center" />
                        <TextBlock Text="备份" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Opacity="0.75" TextWrapping="Wrap" Margin="0,12,0,0"
                               Text="备份文件为标准 JSON 格式（UTF-8），请妥善保管。" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                Click="Export_Click" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileExport" Width="18" Height="18" VerticalAlignment="Center" />
                                <TextBlock Text="导出备份" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}" Click="Import_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileImport" Width="18" Height="18" VerticalAlignment="Center" />
                                <TextBlock Text="导入备份" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

            <!-- 高级 -->
            <materialDesign:Card Margin="0,0,0,14" Padding="20,18" UniformCornerRadius="12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Cog" Width="20" Height="20"
                                                 Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                 VerticalAlignment="Center" />
                        <TextBlock Text="高级" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <TextBlock Text="复制验证码后自动清空剪贴板" VerticalAlignment="Center" />
                        <ComboBox x:Name="ClipboardClearBox"
                                  Width="110" Margin="14,0,0,0"
                                  SelectionChanged="ClipboardClear_SelectionChanged">
                            <ComboBoxItem Content="不启用" Tag="0" />
                            <ComboBoxItem Content="15 秒" Tag="15" />
                            <ComboBoxItem Content="30 秒" Tag="30" />
                            <ComboBoxItem Content="60 秒" Tag="60" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <TextBlock Text="关闭主页面后自动锁定" VerticalAlignment="Center" />
                        <ComboBox x:Name="LockTimeoutBox"
                                  Width="120" Margin="14,0,0,0"
                                  SelectionChanged="LockTimeout_SelectionChanged"
                                  ToolTip="超过该时间后清除内存中的明文密钥，下次打开需重新输入密码解锁">
                            <ComboBoxItem Content="立即" Tag="0" />
                            <ComboBoxItem Content="1 分钟" Tag="1" />
                            <ComboBoxItem Content="5 分钟" Tag="5" />
                            <ComboBoxItem Content="15 分钟" Tag="15" />
                            <ComboBoxItem Content="30 分钟" Tag="30" />
                            <ComboBoxItem Content="1 小时" Tag="60" />
                            <ComboBoxItem Content="从不" Tag="-1" />
                        </ComboBox>
                    </StackPanel>

                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            HorizontalAlignment="Left" Margin="0,14,0,0"
                            Click="OpenDataFolder_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderOpen" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="打开数据文件夹" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </materialDesign:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
