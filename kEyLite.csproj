<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>kEyLite</RootNamespace>
    <AssemblyName>kEyLite</AssemblyName>
    <AssemblyTitle>kEyLite</AssemblyTitle>
    <Product>kEyLite</Product>
    <Version>0.1.0-beta</Version>
    <FileVersion>0.1.0.0</FileVersion>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <InformationalVersion>v0.1-beta - Codename Hyacine</InformationalVersion>
    <Copyright>Copyright © 2026 Startorch Academy Team - Clara Herta</Copyright>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <ApplicationIcon>Assets\App.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MaterialDesignThemes" Version="5.2.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="ZXing.Net" Version="0.16.10" />
  </ItemGroup>

  <!-- WinForms 仅用于托盘 NotifyIcon（全限定名调用），避免隐式 using 造成类型歧义 -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Fonts\HarmonyOS_Sans_SC_Regular.ttf" />
    <Resource Include="Assets\Fonts\HarmonyOS_Sans_SC_Bold.ttf" />
    <Resource Include="Assets\Fonts\HarmonyOS_Sans_SC_Medium.ttf" />
    <Resource Include="Assets\Fonts\HarmonyOS_Sans_SC_Light.ttf" />
    <Resource Include="Assets\Stickers\*.png" />
    <Resource Include="Assets\AppLogo.png" />
    <Resource Include="Assets\App.ico" />
    <None Include="Assets\Fonts\LICENSE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
