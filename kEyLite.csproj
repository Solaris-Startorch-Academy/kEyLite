<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>kEyLite</RootNamespace>
    <AssemblyName>kEyLite</AssemblyName>
    <AssemblyTitle>kEyLite</AssemblyTitle>
    <Product>kEyLite</Product>
    <Company>Startorch Academy Team - Clara Herta</Company>
    <Version>1.1.0</Version>
    <FileVersion>1.1.0.0</FileVersion>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <InformationalVersion>v1.1.0 - Codename Aemeath</InformationalVersion>
    <Copyright>Copyright © 2026 Startorch Academy Team - Clara Herta</Copyright>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <ApplicationIcon>Assets\App.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="MaterialDesignColors" Version="5.2.1" />
    <PackageReference Include="MaterialDesignThemes" Version="5.2.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="ZXing.Net" Version="0.16.10" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Fonts\HarmonyOS_Sans_SC_Regular.ttf" />
    <Resource Include="Assets\Fonts\HarmonyOS_Sans_SC_Bold.ttf" />
    <Resource Include="Assets\Fonts\HarmonyOS_Sans_SC_Medium.ttf" />
    <Resource Include="Assets\Fonts\HarmonyOS_Sans_SC_Light.ttf" />
    <Resource Include="Assets\Stickers\*.png" />
    <Resource Include="Assets\AppLogo.png" />
    <Resource Include="Assets\App.ico" />
    <Resource Include="Assets\Fonts\LICENSE.txt" />
  </ItemGroup>

</Project>
